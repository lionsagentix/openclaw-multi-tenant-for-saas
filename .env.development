# OpenClaw Multi-Tenant Control Plane — Development Environment
#
# Copy this file to .env and fill in the values.
# DO NOT commit .env with real credentials.

# PostgreSQL connection (matches scripts/dev-control-plane.sh defaults)
DATABASE_URL=postgres://openclaw:dev-password-not-for-production@localhost:5432/openclaw_control_plane

# Control plane admin API key (for platform operator endpoints)
CONTROL_PLANE_ADMIN_KEY=dev-admin-key

# Billing provider configuration
BILLING_PROVIDER=stripe
BILLING_API_KEY=sk_test_...
BILLING_WEBHOOK_SECRET=whsec_...

# Platform-provided AI keys (for tenants using credentialMode=platform or hybrid)
# Leave empty if all tenants use BYOK
OPENCLAW_PLATFORM_OPENAI_KEY=
OPENCLAW_PLATFORM_ANTHROPIC_KEY=

# Tenant gateway image (for container orchestration)
TENANT_GATEWAY_IMAGE=openclaw:latest

# Warm pool configuration
WARM_POOL_MIN_SIZE=2
WARM_POOL_MAX_SIZE=10

# Usage collection interval (seconds)
USAGE_COLLECTION_INTERVAL=300
